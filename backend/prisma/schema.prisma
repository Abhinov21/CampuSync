// This tells Prisma which database you're using
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============ ENUMS ============
enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
}

enum AttendanceSessionStatus {
  ACTIVE
  ENDED
}

enum EventType {
  AUTH
  PING
  RECHECK_OK
  SESSION_END
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

// ============ AUTH & USER MANAGEMENT ============
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // hashed
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships (one-to-one with role-specific profile)
  student   Student?
  professor Professor?
  admin     Admin?

  @@map("users")
}

model Student {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  rollNumber  String   @unique
  department  String
  year        Int
  createdAt   DateTime @default(now())

  // Relationships
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  device               Device?
  enrollments          Enrollment[]
  attendanceSessions   AttendanceSession[]
  attendanceRecords    AttendanceRecord[]
  anomalies            AnomalyLog[]

  @@map("students")
}

model Professor {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  employeeId  String   @unique
  department  String
  createdAt   DateTime @default(now())

  // Relationships
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@map("professors")
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// ============ COURSES & ENROLLMENT ============
model Course {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  credits     Int
  semester    String
  professorId String
  createdAt   DateTime @default(now())

  // Relationships
  professor   Professor    @relation(fields: [professorId], references: [id])
  enrollments Enrollment[]
  sessions    Session[]

  @@map("courses")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  enrolledAt DateTime @default(now())

  // Relationships
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Prevent duplicate enrollments
  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

// ============ DEVICES (MQTT Wristbands) ============
model Device {
  id              String   @id @default(uuid())
  deviceId        String   @unique // WB_001, WB_002, etc.
  studentId       String   @unique // One-to-one binding
  deviceStatus    DeviceStatus @default(ACTIVE)
  batteryLevel    Int      @default(100) // 0-100%
  lastPingAt      DateTime?
  assignedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relationships
  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceSessions  AttendanceSession[]
  mqttEventLogs       MQTTEventLog[]
  anomalies           AnomalyLog[]

  @@map("devices")
}

// ============ SESSION MANAGEMENT ============
model Session {
  id                  String   @id @default(uuid())
  courseId            String
  scheduledStartTime  DateTime
  scheduledEndTime    DateTime?
  actualStartTime     DateTime?
  actualEndTime       DateTime?
  sessionStatus       SessionStatus @default(SCHEDULED)
  createdAt           DateTime @default(now())

  // Relationships
  course              Course              @relation(fields: [courseId], references: [id])
  attendanceSessions  AttendanceSession[]

  @@index([courseId])
  @@index([sessionStatus])
  @@map("sessions")
}

// ============ ATTENDANCE TRACKING ============
model AttendanceSession {
  id                  String   @id @default(uuid())
  sessionId           String
  studentId           String
  deviceId            String
  sessionStartTime    DateTime
  lastPingTime        DateTime?
  sessionEndTime      DateTime?
  totalDurationSeconds Int     @default(0)
  sessionStatus       AttendanceSessionStatus @default(ACTIVE)
  reCheckFailureCount Int     @default(0)
  createdAt           DateTime @default(now())

  // Relationships
  session             Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  device              Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  attendanceRecords   AttendanceRecord[]

  @@index([deviceId])
  @@index([studentId])
  @@index([sessionId])
  @@index([sessionStatus])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String   @id @default(uuid())
  attendanceSessionId String
  studentId           String
  eventType           EventType
  eventTimestamp      DateTime
  createdAt           DateTime @default(now())

  // Relationships
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

// ============ LOGGING & MONITORING ============
model MQTTEventLog {
  id              String   @id @default(uuid())
  deviceId        String
  eventType       EventType
  payload         Json     // Raw MQTT message
  processedAt     DateTime?
  status          String   @default("pending") // pending | processed | failed
  errorMessage    String?
  createdAt       DateTime @default(now())

  // Relationships
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Index for time-based queries
  @@index([createdAt])
  @@index([deviceId])
  @@index([status])
  @@map("mqtt_event_logs")
}

model AnomalyLog {
  id              String   @id @default(uuid())
  studentId       String?  // Nullable if device-only anomaly
  deviceId        String?  // Nullable if student-only anomaly
  anomalyType     String   // "device_mismatch", "duplicate_auth", "timeout", etc.
  description     String
  severity        AnomalySeverity
  createdAt       DateTime @default(now())

  // Relationships
  student         Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  device          Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([studentId])
  @@index([createdAt])
  @@index([severity])
  @@map("anomaly_logs")
}