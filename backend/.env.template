# ======================================
# CampuSync Backend Environment Template
# ======================================
# Copy this file to .env and fill in credentials
# Never commit .env to git!

# -------- DATABASE --------
# Supabase PostgreSQL
DATABASE_URL=""

# -------- JWT AUTHENTICATION --------
JWT_SECRET=""
JWT_EXPIRY="7d"

# -------- BCRYPT --------
BCRYPT_ROUNDS=10

# -------- MQTT - HIVEMQ CLOUD --------
MQTT_BROKER=""
MQTT_USERNAME=""
MQTT_PASSWORD=""

# MQTT Topics
MQTT_TOPIC_FINGERPRINT="fingerprint/match"
MQTT_TOPIC_LOG="devicelog/reception"

# MQTT Client Config
MQTT_CLIENT_ID="campusync-backend-dev"
MQTT_RECONNECT_PERIOD=5000

# -------- WEBSOCKET & REAL-TIME --------
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# -------- SERVER --------
PORT=5000
NODE_ENV="development"
LOG_LEVEL="debug"

# -------- TESTING --------
SEED_TEST_USERS="true"

# Session timeout (seconds)
SESSION_PING_TIMEOUT=30

# -------- MONITORING & DEBUGGING --------
DEBUG="campusync:*"
